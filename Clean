-- ============================
-- WRAPPER: Ejecuta tu AutoFarm + limpieza visual + reconexión
-- ============================

-- CONFIG
local RADIO = 120 -- studs: rango alrededor de tu personaje donde actuará
local WAIT_BEFORE_RUN = 4 -- segundos de espera al entrar para que todo cargue
local HIDE_PATTERNS = { "corpse", "dead", "ragdoll", "body", "cadaver" } -- nombres sospechosos

-- Función auxiliar: buscar patrones en nombres
local function nameMatches(name)
	if not name then return false end
	name = name:lower()
	for _, p in ipairs(HIDE_PATTERNS) do
		if string.find(name, p, 1, true) then return true end
	end
	return false
end

-- Ejecuta tu loadstring original
local function runOriginalLoadstring()
	pcall(function()
		getgenv().AutoFarm = true
		loadstring(game:HttpGet("https://raw.githubusercontent.com/caomod2077/Script/refs/heads/main/Farm%20Diamond%20v2.lua"))()
		print("[Wrapper] AutoFarm ejecutado correctamente")
	end)
end

-- Ocultar cadáveres cercanos
local function hideNearbyVisualsOnce()
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	if not player then return end
	local char = player.Character or player.CharacterAdded:Wait()
	local root = char:WaitForChild("HumanoidRootPart", 5)
	if not root then return end

	for _, obj in ipairs(workspace:GetChildren()) do
		if obj ~= char and obj:IsA("Model") then
			local hum = obj:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health and hum.Health <= 0 then
				local primary = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
				if primary and (primary.Position - root.Position).Magnitude <= RADIO then
					for _, part in ipairs(obj:GetDescendants()) do
						if part:IsA("BasePart") then
							part.LocalTransparencyModifier = 1
							pcall(function() part.CastShadow = false end)
						elseif part:IsA("Decal") then
							pcall(function() part.Transparency = 1 end)
						elseif part:IsA("ParticleEmitter") or part:IsA("Trail") then
							pcall(function() part.Enabled = false end)
						elseif part:IsA("PointLight") or part:IsA("SpotLight") or part:IsA("SurfaceLight") then
							pcall(function() part.Enabled = false end)
						end
					end
					print("[Wrapper] Ocultado cadáver:", obj.Name)
				end
			elseif nameMatches(obj.Name) then
				local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
				if primary and (primary.Position - root.Position).Magnitude <= RADIO then
					for _, part in ipairs(obj:GetDescendants()) do
						if part:IsA("BasePart") then
							part.LocalTransparencyModifier = 1
							pcall(function() part.CastShadow = false end)
						elseif part:IsA("Decal") then
							pcall(function() part.Transparency = 1 end)
						elseif part:IsA("ParticleEmitter") or part:IsA("Trail") then
							pcall(function() part.Enabled = false end)
						elseif part:IsA("PointLight") or part:IsA("SpotLight") or part:IsA("SurfaceLight") then
							pcall(function() part.Enabled = false end)
						end
					end
					print("[Wrapper] Ocultado objeto sospechoso:", obj.Name)
				end
			end
		end
	end
end

-- Auto-reconexión si te desconectan
local function setupAutoReconnect()
	local Players = game:GetService("Players")
	local TeleportService = game:GetService("TeleportService")
	local player = Players.LocalPlayer
	if not player then return end

	player.OnRemove:Connect(function()
		task.wait(3)
		pcall(function()
			TeleportService:Teleport(game.PlaceId)
		end)
	end)
end

-- MAIN
task.spawn(function()
	pcall(runOriginalLoadstring)
	task.wait(WAIT_BEFORE_RUN)
	pcall(hideNearbyVisualsOnce)
	pcall(setupAutoReconnect)
	print("[Wrapper] Inicialización completa")
end)
