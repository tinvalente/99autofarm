-- ============================
-- SIMPLE: AutoFarm + Ocultar jugadores muertos + Reconexión
-- ============================

local RADIO = 100 -- distancia máxima (studs) para escanear cadáveres
local RECONNECT_DELAY = 10 -- segundos antes de reconectar

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local player = Players.LocalPlayer

-- Ejecutar tu Diamond Farm
local function runDiamondFarm()
    pcall(function()
        getgenv().AutoFarm = true
        loadstring(game:HttpGet("https://raw.githubusercontent.com/caomod2077/Script/refs/heads/main/Farm%20Diamond%20v2.lua"))()
        print("[AutoFarm] Diamond Farm activado")
    end)
end

-- Función para calcular distancia
local function distancia(a, b)
    return (a - b).Magnitude
end

-- Ocultar jugadores muertos cercanos
local function limpiarMuertos()
    local char = player.Character or player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end

    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj ~= char then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health and hum.Health <= 0 then
                local primary = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart")
                if primary and distancia(root.Position, primary.Position) <= RADIO then
                    -- ocultar localmente
                    for _, part in ipairs(obj:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.LocalTransparencyModifier = 1
                        end
                    end
                    print("[Ocultar] Jugador muerto ocultado:", obj.Name)
                end
            end
        end
    end
end

-- Reconexión automática
local function setupReconnect()
    player.OnRemove:Connect(function()
        print("[Reconectar] Desconectado, esperando "..RECONNECT_DELAY.."s...")
        task.wait(RECONNECT_DELAY)
        pcall(function()
            TeleportService:Teleport(game.PlaceId)
        end)
    end)
end

-- MAIN
task.spawn(function()
    task.wait(5) -- esperar a que el personaje cargue
    runDiamondFarm()
    limpiarMuertos()
    setupReconnect()
    print("[Wrapper] Inicialización completa")
end)
